<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The device id stays on this device: restored on a
     new phone, both phones would write the same files into synced folders. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="settings/device_id" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="settings/device_id" />
    </device-transfer>
</data-extraction-rules>
