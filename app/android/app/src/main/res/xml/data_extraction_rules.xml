<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The device id and the alerts' state stay on this device: restored on a
     new phone, both phones would write the same files into synced folders, and alerts handed
     to the system long ago (kept by the notifications plugin in scheduled_notifications.xml)
     would all ring at the next restart. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="settings/device_id" />
        <exclude domain="file" path="settings/ring_state.json" />
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="settings/device_id" />
        <exclude domain="file" path="settings/ring_state.json" />
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
    </device-transfer>
</data-extraction-rules>
